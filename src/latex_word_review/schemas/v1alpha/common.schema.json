{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:latex-word-review:schema:v1alpha:common",
  "title": "LaTeX Word Review v1alpha common definitions",
  "$defs": {
    "Sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "SemVer": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "StableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*_[a-z0-9]{26,64}$"
    },
    "RunId": {
      "type": "string",
      "pattern": "^run_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "RelativePath": {
      "type": "string",
      "minLength": 1,
      "format": "relative-path"
    },
    "Extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9_-]*[a-z0-9])?)+$"
      },
      "additionalProperties": true
    },
    "Integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_sha256", "document_sha256"],
      "properties": {
        "payload_sha256": {"$ref": "#/$defs/Sha256"},
        "document_sha256": {"$ref": "#/$defs/Sha256"}
      }
    },
    "ToolIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "interface_version",
        "distribution",
        "executable_sha256",
        "configuration_sha256"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"], "minLength": 1},
        "interface_version": {"type": ["string", "null"], "minLength": 1},
        "distribution": {"type": ["string", "null"], "minLength": 1},
        "executable_sha256": {
          "oneOf": [{"$ref": "#/$defs/Sha256"}, {"type": "null"}]
        },
        "configuration_sha256": {
          "oneOf": [{"$ref": "#/$defs/Sha256"}, {"type": "null"}]
        }
      }
    },
    "Profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "configuration_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "configuration_sha256": {"$ref": "#/$defs/Sha256"}
      }
    },
    "ArtifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "path",
        "path_base",
        "role",
        "media_type",
        "size_bytes",
        "sha256",
        "immutable",
        "confidentiality"
      ],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^art_[a-z0-9]{26,64}$"},
        "path": {"$ref": "#/$defs/RelativePath"},
        "path_base": {"enum": ["run_root", "snapshot_root", "bundle_root"]},
        "role": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 3},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/Sha256"},
        "immutable": {"type": "boolean"},
        "confidentiality": {
          "enum": ["public_fixture", "local_private", "derived_private"]
        }
      }
    },
    "SourceLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "start_byte",
        "end_byte",
        "slice_sha256",
        "encoding",
        "newline",
        "start_line",
        "end_line",
        "start_column",
        "end_column"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/RelativePath"},
        "start_byte": {"type": "integer", "minimum": 0},
        "end_byte": {"type": "integer", "minimum": 0},
        "slice_sha256": {"$ref": "#/$defs/Sha256"},
        "encoding": {"type": "string", "minLength": 1},
        "newline": {"enum": ["lf", "crlf", "mixed", "none"]},
        "start_line": {"type": ["integer", "null"], "minimum": 1},
        "end_line": {"type": ["integer", "null"], "minimum": 1},
        "start_column": {"type": ["integer", "null"], "minimum": 1},
        "end_column": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "Diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_id",
        "code",
        "severity",
        "phase",
        "message",
        "recoverable",
        "unit_id",
        "change_id",
        "source_location",
        "evidence",
        "remediation"
      ],
      "properties": {
        "diagnostic_id": {"type": "string", "pattern": "^diag_[a-z0-9]{26,64}$"},
        "code": {"type": "string", "pattern": "^[EW]_[A-Z0-9_]+$"},
        "severity": {"enum": ["info", "warning", "error", "fatal"]},
        "phase": {
          "enum": [
            "doctor", "snapshot", "export", "inspect", "ingest", "review",
            "plan", "apply", "verify", "bundle"
          ]
        },
        "message": {"type": "string"},
        "recoverable": {"type": "boolean"},
        "unit_id": {
          "type": ["string", "null"],
          "pattern": "^unit_[a-z0-9]{26,64}$"
        },
        "change_id": {
          "type": ["string", "null"],
          "pattern": "^chg_[a-z0-9]{26,64}$"
        },
        "source_location": {
          "oneOf": [{"$ref": "#/$defs/SourceLocation"}, {"type": "null"}]
        },
        "evidence": {
          "oneOf": [{"$ref": "#/$defs/ArtifactRef"}, {"type": "null"}]
        },
        "remediation": {"type": ["string", "null"]}
      }
    },
    "ObjectBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_name", "object_id", "payload_sha256", "document_sha256"],
      "properties": {
        "schema_name": {"type": "string", "minLength": 1},
        "object_id": {"$ref": "#/$defs/StableId"},
        "payload_sha256": {"$ref": "#/$defs/Sha256"},
        "document_sha256": {"$ref": "#/$defs/Sha256"}
      }
    },
    "RunPolicyProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "payload_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "payload_sha256": {"$ref": "#/$defs/Sha256"}
      }
    },
    "SelectedBackend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend_id", "role", "capabilities_sha256"],
      "properties": {
        "backend_id": {"type": "string", "minLength": 1},
        "role": {"enum": ["export", "revision_reader", "validator", "baseline"]},
        "capabilities_sha256": {"$ref": "#/$defs/Sha256"}
      }
    },
    "PhaseEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase", "status", "started_at", "completed_at", "input_sha256s",
        "output_sha256s", "diagnostic_ids"
      ],
      "properties": {
        "phase": {
          "enum": [
            "initialized", "snapshotted", "exported", "ingested", "reviewed",
            "planned", "applied", "verified", "bundled"
          ]
        },
        "status": {"enum": ["started", "completed", "blocked", "failed"]},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": ["string", "null"], "format": "date-time"},
        "input_sha256s": {"type": "array", "items": {"$ref": "#/$defs/Sha256"}},
        "output_sha256s": {"type": "array", "items": {"$ref": "#/$defs/Sha256"}},
        "diagnostic_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^diag_[a-z0-9]{26,64}$"},
          "uniqueItems": true
        }
      }
    },
    "RunManifestPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_revision", "previous_manifest_payload_sha256", "status",
        "current_phase", "policy_profile", "source_manifest", "selected_backends",
        "phase_events", "artifacts", "object_bindings", "source_origin_pre_sha256",
        "source_origin_post_sha256", "diagnostics"
      ],
      "properties": {
        "manifest_revision": {"type": "integer", "minimum": 1},
        "previous_manifest_payload_sha256": {
          "oneOf": [{"$ref": "#/$defs/Sha256"}, {"type": "null"}]
        },
        "status": {"enum": ["active", "blocked", "failed", "completed", "aborted"]},
        "current_phase": {
          "enum": [
            "initialized", "snapshotted", "exported", "ingested", "reviewed",
            "planned", "applied", "verified", "bundled"
          ]
        },
        "policy_profile": {"$ref": "#/$defs/RunPolicyProfile"},
        "source_manifest": {
          "oneOf": [{"$ref": "#/$defs/ObjectBinding"}, {"type": "null"}]
        },
        "selected_backends": {"type": "array", "items": {"$ref": "#/$defs/SelectedBackend"}},
        "phase_events": {"type": "array", "items": {"$ref": "#/$defs/PhaseEvent"}},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/ArtifactRef"}},
        "object_bindings": {"type": "array", "items": {"$ref": "#/$defs/ObjectBinding"}},
        "source_origin_pre_sha256": {
          "oneOf": [{"$ref": "#/$defs/Sha256"}, {"type": "null"}]
        },
        "source_origin_post_sha256": {
          "oneOf": [{"$ref": "#/$defs/Sha256"}, {"type": "null"}]
        },
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/Diagnostic"}}
      }
    },
    "SourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "media_type", "size_bytes", "sha256", "encoding", "newline"],
      "properties": {
        "path": {"$ref": "#/$defs/RelativePath"},
        "role": {"enum": ["tex", "bib", "image", "style", "class", "data", "other"]},
        "media_type": {"type": "string", "minLength": 3},
        "size_bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/Sha256"},
        "encoding": {"type": ["string", "null"]},
        "newline": {"enum": ["lf", "crlf", "mixed", "none", null]}
      }
    },
    "DependencyEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind"],
      "properties": {
        "from": {"$ref": "#/$defs/RelativePath"},
        "to": {"$ref": "#/$defs/RelativePath"},
        "kind": {"enum": ["input", "include", "bibliography", "graphic", "package", "class", "other"]}
      }
    },
    "EngineHint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "source", "value"],
      "properties": {
        "engine": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "value": {"type": "string"}
      }
    },
    "ExternalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "status", "diagnostic_ids"],
      "properties": {
        "reference": {"type": "string", "minLength": 1},
        "status": {"enum": ["rejected", "supplied"]},
        "diagnostic_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^diag_[a-z0-9]{26,64}$"}
        }
      }
    },
    "Immutability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_read_only", "source_origin_sha256"],
      "properties": {
        "snapshot_read_only": {"const": true},
        "source_origin_sha256": {"$ref": "#/$defs/Sha256"}
      }
    },
    "SourceManifestPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_manifest_id", "main_document", "snapshot_artifact", "source_tree_sha256",
        "files", "dependency_edges", "engine_hints", "external_references",
        "discovery_profile", "immutability"
      ],
      "properties": {
        "source_manifest_id": {"type": "string", "pattern": "^src_[a-z0-9]{26,64}$"},
        "main_document": {"$ref": "#/$defs/RelativePath"},
        "snapshot_artifact": {"$ref": "#/$defs/ArtifactRef"},
        "source_tree_sha256": {"$ref": "#/$defs/Sha256"},
        "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/SourceFile"}},
        "dependency_edges": {"type": "array", "items": {"$ref": "#/$defs/DependencyEdge"}},
        "engine_hints": {"type": "array", "items": {"$ref": "#/$defs/EngineHint"}},
        "external_references": {"type": "array", "items": {"$ref": "#/$defs/ExternalReference"}},
        "discovery_profile": {"$ref": "#/$defs/Profile"},
        "immutability": {"$ref": "#/$defs/Immutability"}
      }
    },
    "ProbePlatform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "python_version", "external_tools"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1},
        "python_version": {"type": ["string", "null"]},
        "external_tools": {
          "type": "object",
          "additionalProperties": {"type": ["string", "null"]}
        }
      }
    },
    "FeatureCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support", "representations", "preserves_metadata", "diagnostic_codes", "evidence_sha256"],
      "properties": {
        "support": {"enum": ["full", "partial", "none", "unknown"]},
        "representations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "preserves_metadata": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "diagnostic_codes": {"type": "array", "items": {"type": "string", "pattern": "^[EW]_[A-Z0-9_]+$"}},
        "evidence_sha256": {"$ref": "#/$defs/Sha256"}
      }
    },
    "TestedContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture", "result", "evidence_sha256"],
      "properties": {
        "fixture": {"type": "string", "minLength": 1},
        "result": {"enum": ["pass", "fail", "blocked"]},
        "evidence_sha256": {"$ref": "#/$defs/Sha256"}
      }
    },
    "Limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "structure_kind", "fallback"],
      "properties": {
        "code": {"type": "string", "pattern": "^[EW]_[A-Z0-9_]+$"},
        "structure_kind": {"type": "string", "minLength": 1},
        "fallback": {"type": ["string", "null"]}
      }
    },
    "BackendCapabilitiesPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend_id", "backend_role", "tool", "probe_platform", "operations",
        "features", "determinism", "tested_contracts", "limitations",
        "security_requirements", "probe_evidence"
      ],
      "properties": {
        "backend_id": {"type": "string", "minLength": 1},
        "backend_role": {"enum": ["export", "revision_reader", "validator", "baseline"]},
        "tool": {"$ref": "#/$defs/ToolIdentity"},
        "probe_platform": {"$ref": "#/$defs/ProbePlatform"},
        "operations": {
          "type": "array",
          "items": {"enum": ["export_docx", "read_revisions", "validate_docx", "compare_export"]},
          "uniqueItems": true
        },
        "features": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "body_text", "cjk", "inline_math", "display_math", "omml", "images",
              "tables", "bookmarks", "live_fields", "labels", "references", "citations",
              "raw_insert", "raw_delete", "move_pair", "format_revision", "comments",
              "comment_range", "source_spans"
            ]
          },
          "additionalProperties": {"$ref": "#/$defs/FeatureCapability"}
        },
        "determinism": {"enum": ["verified", "claimed", "not_verified", "failed"]},
        "tested_contracts": {"type": "array", "items": {"$ref": "#/$defs/TestedContract"}},
        "limitations": {"type": "array", "items": {"$ref": "#/$defs/Limitation"}},
        "security_requirements": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "probe_evidence": {"type": "array", "items": {"$ref": "#/$defs/ArtifactRef"}}
      }
    },
    "ReviewUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id", "kind", "ordinal", "parent_unit_id", "source_location",
        "normalized_text", "normalized_text_sha256", "semantic_role", "risk_class",
        "neighbor_unit_ids", "diagnostic_ids"
      ],
      "properties": {
        "unit_id": {"type": "string", "pattern": "^unit_[a-z0-9]{26,64}$"},
        "kind": {
          "enum": [
            "document", "title", "heading", "paragraph", "list_item", "caption",
            "table", "table_cell", "equation", "figure", "citation", "reference",
            "footnote", "code", "unknown"
          ]
        },
        "ordinal": {"type": "integer", "minimum": 0},
        "parent_unit_id": {
          "type": ["string", "null"],
          "pattern": "^unit_[a-z0-9]{26,64}$"
        },
        "source_location": {"$ref": "#/$defs/SourceLocation"},
        "normalized_text": {"type": ["string", "null"]},
        "normalized_text_sha256": {"$ref": "#/$defs/Sha256"},
        "semantic_role": {"type": ["string", "null"]},
        "risk_class": {
          "enum": [
            "plain_text_low", "formula_high", "reference_high", "table_high",
            "resource_high", "structural_high", "unknown_denied"
          ]
        },
        "neighbor_unit_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^unit_[a-z0-9]{26,64}$"},
          "uniqueItems": true
        },
        "diagnostic_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^diag_[a-z0-9]{26,64}$"},
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "unknown"}}, "required": ["kind"]},
          "then": {"properties": {"risk_class": {"const": "unknown_denied"}}}
        }
      ]
    },
    "ReviewRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "from_unit_id", "to_unit_id"],
      "properties": {
        "kind": {"enum": ["parent", "reference", "caption", "label", "other"]},
        "from_unit_id": {"type": "string", "pattern": "^unit_[a-z0-9]{26,64}$"},
        "to_unit_id": {"type": "string", "pattern": "^unit_[a-z0-9]{26,64}$"}
      }
    },
    "ReviewIRPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_manifest_sha256", "source_tree_sha256", "normalization_profile",
        "document_language_hints", "units", "relations", "diagnostics"
      ],
      "properties": {
        "source_manifest_sha256": {"$ref": "#/$defs/Sha256"},
        "source_tree_sha256": {"$ref": "#/$defs/Sha256"},
        "normalization_profile": {"$ref": "#/$defs/Profile"},
        "document_language_hints": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"},
          "uniqueItems": true
        },
        "units": {"type": "array", "items": {"$ref": "#/$defs/ReviewUnit"}},
        "relations": {"type": "array", "items": {"$ref": "#/$defs/ReviewRelation"}},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/Diagnostic"}}
      }
    },
    "DocxAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part_uri", "kind", "name", "paragraph_id", "object_id"],
      "properties": {
        "part_uri": {"$ref": "#/$defs/RelativePath"},
        "kind": {"enum": ["bookmark", "content_control", "paragraph", "object", "none"]},
        "name": {"type": ["string", "null"]},
        "paragraph_id": {"type": ["string", "null"]},
        "object_id": {"type": ["string", "null"]}
      }
    },
    "SourceFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slice_sha256", "normalized_text_sha256", "neighbor_sha256"],
      "properties": {
        "slice_sha256": {"$ref": "#/$defs/Sha256"},
        "normalized_text_sha256": {"$ref": "#/$defs/Sha256"},
        "neighbor_sha256": {"$ref": "#/$defs/Sha256"}
      }
    },
    "SourceMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id", "source_location", "docx_anchor", "source_fingerprint",
        "mapping_method", "confidence", "status"
      ],
      "properties": {
        "unit_id": {"type": "string", "pattern": "^unit_[a-z0-9]{26,64}$"},
        "source_location": {"$ref": "#/$defs/SourceLocation"},
        "docx_anchor": {"$ref": "#/$defs/DocxAnchor"},
        "source_fingerprint": {"$ref": "#/$defs/SourceFingerprint"},
        "mapping_method": {
          "enum": ["exact_source_span", "bookmark", "source_fingerprint", "manual", "none"]
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "status": {"enum": ["exact", "degraded", "unmapped", "conflict"]}
      }
    },
    "Coverage": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      },
      "required": ["total", "exact", "degraded", "unmapped", "conflict"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "exact": {"type": "integer", "minimum": 0},
        "degraded": {"type": "integer", "minimum": 0},
        "unmapped": {"type": "integer", "minimum": 0},
        "conflict": {"type": "integer", "minimum": 0}
      }
    },
    "SourceMapPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_manifest_sha256", "review_ir_sha256", "review_docx_sha256",
        "anchor_profile", "mappings", "coverage", "diagnostics"
      ],
      "properties": {
        "source_manifest_sha256": {"$ref": "#/$defs/Sha256"},
        "review_ir_sha256": {"$ref": "#/$defs/Sha256"},
        "review_docx_sha256": {"$ref": "#/$defs/Sha256"},
        "anchor_profile": {"$ref": "#/$defs/Profile"},
        "mappings": {"type": "array", "items": {"$ref": "#/$defs/SourceMapping"}},
        "coverage": {"$ref": "#/$defs/Coverage"},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/Diagnostic"}}
      }
    },
    "MetricCounts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "ExportMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "output"],
      "properties": {
        "source": {"$ref": "#/$defs/MetricCounts"},
        "output": {"$ref": "#/$defs/MetricCounts"}
      }
    },
    "FeatureResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature", "status", "source_count", "output_count", "diagnostic_ids"],
      "properties": {
        "feature": {"type": "string", "minLength": 1},
